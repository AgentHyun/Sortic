<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.sortic.sorticproject.Mapper.RefreshTokenMapper">

  <insert id="save" parameterType="org.sortic.sorticproject.Entity.RefreshToken">
    REPLACE INTO refresh_token (user_id, token, expiry)
    VALUES (#{userId}, #{token}, #{expiry})
  </insert>

  <select id="find" parameterType="string"
          resultType="org.sortic.sorticproject.Entity.RefreshToken">
    SELECT user_id, token, expiry
    FROM   refresh_token
    WHERE  user_id = #{userId}
  </select>

  <delete id="delete" parameterType="string">
    DELETE FROM refresh_token WHERE user_id = #{userId}
  </delete>

</mapper>
